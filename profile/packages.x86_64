# Prime-OS Core Profile Packages
# Optimized for size and broad graphics card compatibility
# Preview-only mode: does not partition disk or install OS

# --- Core system ---
base
sudo
coreutils
diffutils
grep
findutils

# --- Desktop base (minimal Wayland compositor)#
# Window manager and panel (lightweight, works with all GPUs)
hyprland
waybar
wofi
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk

# --- Essential utilities ---
# File management and desktop
pcmanfm
thunar
nitrogen


# --- Audio (lightweight) ---
pipewire
pipewire-alsa
pulseaudio
alsa-utils

# --- Network ---
networkmanager
connman

# --- Display and fonts ---
# Fonts (minimal set)
noto-fonts
noto-fonts-cjk
noto-fonts-emoji

# --- Vulkan/Mesa for broad GPU compatibility ---
# Supports: AMD Radeon, Intel Integrated, NVIDIA (open source)
mesa
vulkan-radeon
vulkan-intel
vulkan-nouveau
nvidia-open
lib32-mesa
lib32-vulkan-radeon
lib32-vulkan-intel
lib32-vulkan-nouveau
lib32-nvidia-utils

# --- Basic desktop apps ---
firefox
udisks2
ntfs-3g
bluez


# --- Productivity (lightweight) ---
geany

# --- Removed for size optimization ---
# Removed: steam, lutris, pipewire-pulse, wireplumber,
